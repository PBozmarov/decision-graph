rules_version = '2';

// Private app: only the owner's account may read or write, and only its own decisions.
// The owner is identified by Firebase user ID (not email) so no personal data is in the repo.
// Any other Google account can complete Google's sign-in screen but is refused here.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && uid == '8XVQGGB4jrVpNd1h90RRJ0eJo8Y2';
    }
    match /users/{uid}/docs/{docId} {
      allow read, write: if isOwner(uid);
    }
  }
}
